{
  "name": "gainz",
  "displayName": "GAINZ — Guard AI NEAR ZK",
  "version": "0.1.0",
  "description": "MCP server that routes every NEAR AI agent payment through GuardVault, which enforces caps, allowlists and Noir proofs on chain.",
  "repository": "https://github.com/memgochain/near-agent-guard",
  "mcpServers": {
    "near-agent-guard": {
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "-p",
        "near_guard_mcp",
        "--",
        "--policy",
        "/absolute/path/policy/policy.json"
      ],
      "env": {
        "NEAR_AI_API_KEY": "optional",
        "CEREBRAS_API_KEY": "optional"
      }
    }
  },
  "tools": [
    "near_safe_transfer",
    "near_policy_status",
    "near_run_range",
    "near_audit_trail",
    "near_report_anchor_payload"
  ],
  "nearAiCloud": {
    "endpoint": "https://near.ai",
    "model": "fireworks::accounts/fireworks/models/llama-v3p1-70b-instruct",
    "purpose": "agent intent generation for --demo",
    "envVar": "NEAR_AI_API_KEY",
    "fallback": ["CEREBRAS_API_KEY", "offline simulation"]
  },
  "guardVault": {
    "keyScope": "function-call access key",
    "description": "The agent can only call GuardVault. It cannot transfer directly, edit limits, extend the allowlist, or anchor reports.",
    "enforcedOnChain": ["per-tx cap", "24h window", "allowlist", "Noir proof presence"]
  }
}
